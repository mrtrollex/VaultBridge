# Copy as .env and keep your existing long random API key here.
API_KEY=replace-with-your-existing-long-random-secret
# Optional: set only to the old key during a controlled rotation window.
API_KEY_PREVIOUS=
# Process-local protection against accidental request loops and lightweight abuse.
RATE_LIMIT_ENABLED=true
RATE_LIMIT_REQUESTS=120
RATE_LIMIT_WINDOW_SECONDS=60
RATE_LIMIT_MAX_CLIENTS=1024
# Leave disabled unless the actual TrueNAS Host and any client Origin are explicitly allowlisted.
MCP_HTTP_ENABLED=false
MCP_WRITE_ENABLED=false
MCP_HTTP_ALLOWED_HOSTS=127.0.0.1:*,localhost:*,[::1]:*
MCP_HTTP_ALLOWED_ORIGINS=http://127.0.0.1:*,http://localhost:*,http://[::1]:*
SEMANTIC_WATCH_ENABLED=false
SEMANTIC_WATCH_DEBOUNCE_SECONDS=1.0
